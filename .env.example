DJANGO_SECRET_KEY=replace-with-a-strong-secret
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
# Add the portal host's LAN IP or DNS name to ALLOWED_HOSTS when browsing remotely.

# Active Directory / LDAP settings
AD_SERVER=
AD_HOSTNAME=
AD_DOMAIN=
AD_NETBIOS_DOMAIN=
AD_PORT=389
AD_LDAPS_PORT=636
AD_LDAP_ENCRYPTION=ldaps
AD_LDAP_CA_CERTS_FILE=
AD_AUTH_METHOD=SIMPLE
AD_USER_SEARCH_FILTER=(&(objectCategory=person)(objectClass=user)(sAMAccountName={username}))
AD_LDAP_SERVER=
AD_BASE_DN=
AD_USER_SEARCH_BASE=
AD_GROUP_SEARCH_BASE=
AD_BIND_USERNAME=
AD_BIND_PASSWORD=
AD_TEST_USERNAME=

# File server configuration
FILE_SERVER=
FILE_SERVER_IP=
DISPLAY_OS=windows

# SMB shares mounted by the web container. Use comma-separated mount-slug=share entries.
# The mount slug becomes /app/shares/<slug>; set OU_SUBJECT_MAP paths to match.
SMB_HOST=<smb-server-dns-name-or-ip>
SMB_MOUNTS=<mount-slug>=<share-name>
SMB_CREDENTIALS_SOURCE=./secrets/smb_credentials
SHARE_MOUNT_ROOT=/app/shares
LDAP_OU_DEPTH_INDEX=0
# JSON object: OU name -> list of absolute paths below SHARE_MOUNT_ROOT.
# Example shape only: {"<OU_NAME>":["/app/shares/<subject-directory>"]}
OU_SUBJECT_MAP={}

# PostgreSQL settings
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=portal-db
POSTGRES_PORT=5432

# Legacy group map (unused by OU-based material browsing).
AD_SHARE_GROUPS={}
